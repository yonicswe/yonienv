git sm foreach |tr -d "'"|cut -f 2 -d' ' | while read s ; do
        cd $s ;
        if [[ "$(git bb)" == "HEAD" ]] ; then
            #echo -e "\033[0;32m$(git hh | awk '{printf "%.12s",$0}') $s\033[0m" ;
            echo -e "${BLUE}$(git hh | awk '{printf "%.12s",$0}')${NC} $s" ;
